[Desktop Entry]
Type=Application
Version=1.5
Name=Netkeep
Comment=Network flow authorization and pending decision UI
Exec=sh -c 'NETKEEP_SOCKET_PATH=${NETKEEP_SOCKET_PATH:-/run/netkeep/netkeep.sock} exec netkeep-gpui'
Icon=io.logicamp.Netkeep
Terminal=false
Categories=Network;Security;Monitor;
Keywords=firewall;network;security;vpn;
StartupNotify=true
