# Maintainer: build from a clean clone of the LogiGuard repository.
# Run `makepkg -sf` from this directory (`packaging/archlinux`); the build
# uses the repository root at ../../ relative to this PKGBUILD.

pkgname=logiguard
pkgver=0.1.0
pkgrel=4
pkgdesc='Linux desktop network flow authorization (daemon, CLI, GPUI tray)'
arch=('x86_64')
url='https://github.com/mohammadreza-khani/logiguard'
license=('Apache')
depends=(
  'gcc-libs'
  'glibc'
  'gtk-update-icon-cache'  # post-install icon cache refresh (standalone pkg, not gtk3)
  'hicolor-icon-theme'
  'libxkbcommon'
  'xdotool'
)
makedepends=('pkgconf' 'clang' 'llvm' 'rsync')
optdepends=(
  'vulkan-mesa-layers: GPU stack for GPUI on some setups'
  'systemd-resolved: disable stub listener if using LOGIGUARD_DNS_FORWARDER on port 53'
)
options=('!lto' '!debug')
install=logiguard.install

prepare() {
  _root="$(cd "${startdir}/../.." && pwd)"
  if [[ ! -f "${_root}/Cargo.toml" ]]; then
    echo "error: expected LogiGuard workspace at ${_root}" >&2
    exit 1
  fi
  rm -rf "${srcdir}/build"
  mkdir -p "${srcdir}/build"
  rsync -a --delete \
    --exclude target \
    --exclude .git \
    --exclude packaging/archlinux/src \
    --exclude packaging/archlinux/pkg \
    "${_root}/" "${srcdir}/build/"

  # Isolated toolchain for makepkg. The single stable toolchain (pinned via
  # rust-toolchain.toml = 1.96.1) builds everything: the workspace, bpf-linker,
  # and the eBPF programs. The eBPF step uses -Z build-std=core (unstable)
  # unlocked on stable via RUSTC_BOOTSTRAP=1 — no nightly toolchain required.
  export CARGO_HOME="${srcdir}/.cargo"
  mkdir -p "${CARGO_HOME}"

  # bpf-linker 0.11 regressed: it rejects code that lowers to `memset`
  # libcalls ("A call to built-in function 'memset' is not supported"),
  # where 0.10.x inline-compiles them. Pin until upstream fixes it.
  cargo install bpf-linker --version 0.10.4 --root "${CARGO_HOME}" --locked 2>/dev/null \
    || cargo install bpf-linker --version 0.10.4 --root "${CARGO_HOME}"
}

build() {
  cd "${srcdir}/build"
  export CARGO_HOME="${srcdir}/.cargo"
  export PATH="${CARGO_HOME}/bin:${PATH}"

  # eBPF object must exist before dns-tracker embeds it via include_bytes!.
  # RUSTC_BOOTSTRAP=1 unlocks -Z build-std=core on the stable toolchain.
  RUSTC_BOOTSTRAP=1 cargo xtask build-ebpf-release
  cargo build --workspace --release --locked
}

package() {
  cd "${srcdir}/build"
  install -Dm755 target/release/logiguard-daemon "${pkgdir}/usr/bin/logiguardd"
  install -Dm755 target/release/logiguard-cli "${pkgdir}/usr/bin/logiguard-cli"
  install -Dm755 target/release/logiguard-gpui "${pkgdir}/usr/bin/logiguard-gpui"

  install -Dm644 resources/linux/systemd/logiguardd.service \
    "${pkgdir}/usr/lib/systemd/system/logiguardd.service"
  install -Dm644 resources/linux/applications/io.logicamp.LogiGuard.desktop \
    "${pkgdir}/usr/share/applications/io.logicamp.LogiGuard.desktop"
  install -Dm644 resources/linux/icons/hicolor/scalable/apps/io.logicamp.LogiGuard.svg \
    "${pkgdir}/usr/share/icons/hicolor/scalable/apps/io.logicamp.LogiGuard.svg"

  install -Dm644 "${startdir}/environment.d-logiguard.conf" \
    "${pkgdir}/etc/environment.d/logiguard.conf"
}
