# Maintainer: build from a clean clone of the Netkeep repository.
# Run `makepkg -sf` from this directory (`packaging/archlinux`); the build
# uses the repository root at ../../ relative to this PKGBUILD.
#
# Build caching: cargo artifacts go to `${startdir}/.cargo-target`, which
# survives `makepkg -C` (cleanbuild) because it lives outside `${srcdir}`.
# `rsync -a` in prepare() preserves mtimes, so unchanged crates stay cached and
# only edited ones rebuild. Note `-C` still wipes `${srcdir}/.cargo`, forcing a
# bpf-linker rebuild — omit `-C` to keep that too.
#
# For plain dev iteration prefer `just dev-install` from the repo root: it
# builds in-tree against the warm `target/` and skips packaging entirely.

pkgname=netkeep
pkgver=0.1.0
pkgrel=4
pkgdesc='Linux desktop network flow authorization (daemon, CLI, GPUI tray)'
arch=('x86_64')
url='https://github.com/mohamadkhani/netkeep'
license=('GPL-3.0-or-later')
depends=(
  'gcc-libs'
  'glibc'
  'gtk-update-icon-cache'  # post-install icon cache refresh (standalone pkg, not gtk3)
  'hicolor-icon-theme'
  'libxkbcommon'
  'libxcb'
  'sqlite'  # netkeepd links system libsqlite3 (rusqlite is not bundled)
  'xdotool'
)
makedepends=('pkgconf' 'clang' 'llvm' 'rsync')
optdepends=(
  'vulkan-mesa-layers: GPU stack for GPUI on some setups'
  'systemd-resolved: disable stub listener if using NETKEEP_DNS_FORWARDER on port 53'
)
options=('!lto' '!debug')
install=netkeep.install

prepare() {
  _root="$(cd "${startdir}/../.." && pwd)"
  if [[ ! -f "${_root}/Cargo.toml" ]]; then
    echo "error: expected Netkeep workspace at ${_root}" >&2
    exit 1
  fi
  rm -rf "${srcdir}/build"
  mkdir -p "${srcdir}/build"
  rsync -a --delete \
    --exclude target \
    --exclude .git \
    --exclude packaging/archlinux/src \
    --exclude packaging/archlinux/pkg \
    "${_root}/" "${srcdir}/build/"

  # Isolated toolchain for makepkg. The single stable toolchain (pinned via
  # rust-toolchain.toml = 1.96.0) builds everything: the workspace, bpf-linker,
  # and the eBPF programs. The eBPF step uses -Z build-std=core (unstable)
  # unlocked on stable via RUSTC_BOOTSTRAP=1 — no nightly toolchain required.
  export CARGO_HOME="${srcdir}/.cargo"
  mkdir -p "${CARGO_HOME}"

  # bpf-linker 0.11 regressed: it rejects code that lowers to `memset`
  # libcalls ("A call to built-in function 'memset' is not supported"),
  # where 0.10.x inline-compiles them. Pin until upstream fixes it.
  cargo install bpf-linker --version 0.10.4 --root "${CARGO_HOME}" --locked 2>/dev/null \
    || cargo install bpf-linker --version 0.10.4 --root "${CARGO_HOME}"
}

build() {
  cd "${srcdir}/build"
  export CARGO_HOME="${srcdir}/.cargo"
  export PATH="${CARGO_HOME}/bin:${PATH}"

  # Persistent target dir outside ${srcdir} so cleanbuild (-C) doesn't wipe it.
  # Keep it dedicated to this packaging build: sharing the repo's own target/
  # would churn fingerprints, since we compile from ${srcdir}/build rather than
  # the repo root, and each build would invalidate the other's cache.
  export CARGO_TARGET_DIR="${startdir}/.cargo-target"

  # eBPF object must exist before dns-tracker embeds it via include_bytes!.
  # RUSTC_BOOTSTRAP=1 unlocks -Z build-std=core on the stable toolchain.
  # xtask pins its own CARGO_TARGET_DIR internally (the include_bytes! path in
  # dns-tracker hardcodes it), so CARGO_TARGET_DIR here doesn't affect it.
  RUSTC_BOOTSTRAP=1 cargo xtask build-ebpf-release
  cargo build --workspace --release --locked
}

package() {
  cd "${srcdir}/build"
  export CARGO_TARGET_DIR="${startdir}/.cargo-target"
  install -Dm755 "${CARGO_TARGET_DIR}/release/netkeep-daemon" "${pkgdir}/usr/bin/netkeepd"
  install -Dm755 "${CARGO_TARGET_DIR}/release/netkeep-cli" "${pkgdir}/usr/bin/netkeep-cli"
  install -Dm755 "${CARGO_TARGET_DIR}/release/netkeep-gpui" "${pkgdir}/usr/bin/netkeep-gpui"

  install -Dm644 resources/linux/systemd/netkeepd.service \
    "${pkgdir}/usr/lib/systemd/system/netkeepd.service"
  install -Dm644 resources/linux/applications/io.logicamp.Netkeep.desktop \
    "${pkgdir}/usr/share/applications/io.logicamp.Netkeep.desktop"
  install -Dm644 resources/linux/icons/hicolor/scalable/apps/io.logicamp.Netkeep.svg \
    "${pkgdir}/usr/share/icons/hicolor/scalable/apps/io.logicamp.Netkeep.svg"

  install -Dm644 "${startdir}/environment.d-netkeep.conf" \
    "${pkgdir}/etc/environment.d/netkeep.conf"
}
