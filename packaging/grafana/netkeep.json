{
  "description": "Netkeep firewall daemon metrics",
  "editable": true,
  "graphTooltip": 1,
  "links": [],
  "panels": [
    {
      "title": "Packet Pipeline",
      "type": "row",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "collapsed": false
    },
    {
      "title": "Packets / sec",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "$datasource" },
      "fieldConfig": {
        "defaults": {
          "unit": "pps",
          "custom": { "drawStyle": "line", "fillOpacity": 10, "spanNulls": true }
        },
        "overrides": []
      },
      "targets": [
        { "expr": "rate(netkeep_packets_received_total[1m])", "legendFormat": "received", "refId": "A" },
        { "expr": "rate(netkeep_packets_accepted_total[1m])", "legendFormat": "accepted ({{reason}})", "refId": "B" },
        { "expr": "rate(netkeep_packets_dropped_total[1m])", "legendFormat": "dropped ({{reason}})", "refId": "C" },
        { "expr": "rate(netkeep_packets_parse_failed_total[1m])", "legendFormat": "parse failed", "refId": "D" }
      ]
    },
    {
      "title": "Packet Verdict Breakdown",
      "type": "piechart",
      "gridPos": { "h": 8, "w": 4, "x": 8, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "$datasource" },
      "fieldConfig": { "defaults": {}, "overrides": [] },
      "targets": [
        { "expr": "sum(increase(netkeep_packets_accepted_total[5m]))", "legendFormat": "Accepted", "refId": "A" },
        { "expr": "sum(increase(netkeep_packets_dropped_total[5m]))", "legendFormat": "Dropped", "refId": "B" }
      ]
    },
    {
      "title": "Packet Processing Latency",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "$datasource" },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": { "drawStyle": "line", "fillOpacity": 10, "spanNulls": true }
        },
        "overrides": []
      },
      "targets": [
        { "expr": "netkeep_packet_processing_duration{quantile=\"0.5\"}", "legendFormat": "p50", "refId": "A" },
        { "expr": "netkeep_packet_processing_duration{quantile=\"0.95\"}", "legendFormat": "p95", "refId": "B" },
        { "expr": "netkeep_packet_processing_duration{quantile=\"0.99\"}", "legendFormat": "p99", "refId": "C" }
      ]
    },
    {
      "title": "Accept Reason Breakdown",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "$datasource" },
      "fieldConfig": {
        "defaults": {
          "unit": "pps",
          "custom": { "drawStyle": "stacked_line", "fillOpacity": 30, "spanNulls": true }
        },
        "overrides": []
      },
      "targets": [
        { "expr": "rate(netkeep_packets_accepted_total[1m])", "legendFormat": "{{reason}}", "refId": "A" }
      ]
    },
    {
      "title": "Verdict Cache",
      "type": "row",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 9 },
      "collapsed": false
    },
    {
      "title": "Cache Entries",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 9, "x": 0, "y": 10 },
      "datasource": { "type": "prometheus", "uid": "$datasource" },
      "fieldConfig": {
        "defaults": { "custom": { "drawStyle": "line", "fillOpacity": 10, "spanNulls": true } },
        "overrides": []
      },
      "targets": [
        { "expr": "netkeep_verdict_cache_entries", "legendFormat": "verdict cache", "refId": "A" },
        { "expr": "netkeep_proc_attr_cache_entries{cache=\"ip\"}", "legendFormat": "proc attr (IP)", "refId": "B" },
        { "expr": "netkeep_proc_attr_cache_entries{cache=\"domain\"}", "legendFormat": "proc attr (domain)", "refId": "C" }
      ]
    },
    {
      "title": "Cache Evictions / sec",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 9, "x": 9, "y": 10 },
      "datasource": { "type": "prometheus", "uid": "$datasource" },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": { "drawStyle": "line", "fillOpacity": 10, "spanNulls": true }
        },
        "overrides": []
      },
      "targets": [
        { "expr": "rate(netkeep_verdict_cache_evictions_total[1m])", "legendFormat": "{{reason}}", "refId": "A" }
      ]
    },
    {
      "title": "Cache Hit Rate",
      "type": "gauge",
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 10 },
      "datasource": { "type": "prometheus", "uid": "$datasource" },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 0.5 },
              { "color": "green", "value": 0.8 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "rate(netkeep_packets_accepted_total{reason=\"cache_hit\"}[5m]) / rate(netkeep_packets_received_total[5m])",
          "legendFormat": "hit rate",
          "refId": "A"
        }
      ]
    },
    {
      "title": "Process Resolver",
      "type": "row",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 18 },
      "collapsed": false
    },
    {
      "title": "Process Resolution",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 19 },
      "datasource": { "type": "prometheus", "uid": "$datasource" },
      "fieldConfig": {
        "defaults": {
          "unit": "pps",
          "custom": { "drawStyle": "line", "fillOpacity": 10, "spanNulls": true }
        },
        "overrides": []
      },
      "targets": [
        { "expr": "rate(netkeep_process_resolved_total[1m])", "legendFormat": "{{result}}", "refId": "A" }
      ]
    },
    {
      "title": "Proc Resolver Cache",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 19 },
      "datasource": { "type": "prometheus", "uid": "$datasource" },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": { "drawStyle": "line", "fillOpacity": 10, "spanNulls": true }
        },
        "overrides": []
      },
      "targets": [
        { "expr": "rate(netkeep_proc_resolver_cache_hits_total[1m])", "legendFormat": "hits", "refId": "A" },
        { "expr": "rate(netkeep_proc_resolver_cache_misses_total[1m])", "legendFormat": "misses", "refId": "B" }
      ]
    },
    {
      "title": "Proc Resolve Latency",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 19 },
      "datasource": { "type": "prometheus", "uid": "$datasource" },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": { "drawStyle": "line", "fillOpacity": 10, "spanNulls": true }
        },
        "overrides": []
      },
      "targets": [
        { "expr": "netkeep_proc_resolver_resolve_duration{quantile=\"0.5\"}", "legendFormat": "p50", "refId": "A" },
        { "expr": "netkeep_proc_resolver_resolve_duration{quantile=\"0.95\"}", "legendFormat": "p95", "refId": "B" },
        { "expr": "netkeep_proc_resolver_resolve_duration{quantile=\"0.99\"}", "legendFormat": "p99", "refId": "C" }
      ]
    },
    {
      "title": "Pending Decisions",
      "type": "row",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 27 },
      "collapsed": false
    },
    {
      "title": "Active Pending Decisions",
      "type": "stat",
      "gridPos": { "h": 8, "w": 4, "x": 0, "y": 28 },
      "datasource": { "type": "prometheus", "uid": "$datasource" },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 50 },
              { "color": "red", "value": 80 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        { "expr": "netkeep_pending_decisions", "legendFormat": "pending", "refId": "A" }
      ]
    },
    {
      "title": "Pending Lifecycle / sec",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 10, "x": 4, "y": 28 },
      "datasource": { "type": "prometheus", "uid": "$datasource" },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": { "drawStyle": "line", "fillOpacity": 10, "spanNulls": true }
        },
        "overrides": []
      },
      "targets": [
        { "expr": "rate(netkeep_pending_created_total[1m])", "legendFormat": "created ({{protocol}})", "refId": "A" },
        { "expr": "rate(netkeep_pending_resolved_total[1m])", "legendFormat": "resolved ({{action}})", "refId": "B" },
        { "expr": "rate(netkeep_pending_expired_total[1m])", "legendFormat": "expired", "refId": "C" },
        { "expr": "rate(netkeep_pending_deduplicated_total[1m])", "legendFormat": "deduped ({{type}})", "refId": "D" },
        { "expr": "rate(netkeep_pending_overflow_total[1m])", "legendFormat": "overflow ({{policy}})", "refId": "E" }
      ]
    },
    {
      "title": "Pending Decisions Over Time",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 10, "x": 14, "y": 28 },
      "datasource": { "type": "prometheus", "uid": "$datasource" },
      "fieldConfig": {
        "defaults": { "custom": { "drawStyle": "line", "fillOpacity": 20, "spanNulls": true } },
        "overrides": []
      },
      "targets": [
        { "expr": "netkeep_pending_decisions", "legendFormat": "active pending", "refId": "A" }
      ]
    },
    {
      "title": "Policy Engine",
      "type": "row",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 36 },
      "collapsed": false
    },
    {
      "title": "Policy Evaluations / sec",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 10, "x": 0, "y": 37 },
      "datasource": { "type": "prometheus", "uid": "$datasource" },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": { "drawStyle": "line", "fillOpacity": 10, "spanNulls": true }
        },
        "overrides": []
      },
      "targets": [
        { "expr": "rate(netkeep_policy_evaluations_total[1m])", "legendFormat": "evaluations", "refId": "A" },
        { "expr": "rate(netkeep_policy_resolved_total[1m])", "legendFormat": "resolved ({{action}})", "refId": "B" },
        { "expr": "rate(netkeep_policy_no_match_total[1m])", "legendFormat": "no match", "refId": "C" }
      ]
    },
    {
      "title": "Policy Evaluation Latency",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 10, "x": 10, "y": 37 },
      "datasource": { "type": "prometheus", "uid": "$datasource" },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": { "drawStyle": "line", "fillOpacity": 10, "spanNulls": true }
        },
        "overrides": []
      },
      "targets": [
        { "expr": "netkeep_policy_evaluation_duration{quantile=\"0.5\"}", "legendFormat": "p50", "refId": "A" },
        { "expr": "netkeep_policy_evaluation_duration{quantile=\"0.95\"}", "legendFormat": "p95", "refId": "B" },
        { "expr": "netkeep_policy_evaluation_duration{quantile=\"0.99\"}", "legendFormat": "p99", "refId": "C" }
      ]
    },
    {
      "title": "Policy Match Rate",
      "type": "gauge",
      "gridPos": { "h": 8, "w": 4, "x": 20, "y": 37 },
      "datasource": { "type": "prometheus", "uid": "$datasource" },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 0.3 },
              { "color": "green", "value": 0.6 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum(rate(netkeep_policy_resolved_total[5m])) / sum(rate(netkeep_policy_evaluations_total[5m]))",
          "legendFormat": "match rate",
          "refId": "A"
        }
      ]
    },
    {
      "title": "Control Service",
      "type": "row",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 45 },
      "collapsed": false
    },
    {
      "title": "Control Requests / sec",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 46 },
      "datasource": { "type": "prometheus", "uid": "$datasource" },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": { "drawStyle": "line", "fillOpacity": 10, "spanNulls": true }
        },
        "overrides": []
      },
      "targets": [
        { "expr": "rate(netkeep_control_requests_total[1m])", "legendFormat": "{{type}}", "refId": "A" }
      ]
    },
    {
      "title": "Immediate Verdicts vs Pending",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 46 },
      "datasource": { "type": "prometheus", "uid": "$datasource" },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": { "drawStyle": "line", "fillOpacity": 10, "spanNulls": true }
        },
        "overrides": []
      },
      "targets": [
        { "expr": "rate(netkeep_control_immediate_verdicts_total[1m])", "legendFormat": "immediate ({{action}})", "refId": "A" },
        { "expr": "rate(netkeep_control_pending_created_total[1m])", "legendFormat": "pending created", "refId": "B" }
      ]
    },
    {
      "title": "DNS Snooping",
      "type": "row",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 54 },
      "collapsed": false
    },
    {
      "title": "DNS Snoop Activity",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 55 },
      "datasource": { "type": "prometheus", "uid": "$datasource" },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": { "drawStyle": "line", "fillOpacity": 10, "spanNulls": true }
        },
        "overrides": []
      },
      "targets": [
        { "expr": "rate(netkeep_dns_snoop_packets_total[1m])", "legendFormat": "packets", "refId": "A" },
        { "expr": "rate(netkeep_dns_snoop_entries_learned_total[1m])", "legendFormat": "entries learned", "refId": "B" }
      ]
    },
    {
      "title": "DNS Parse Outcome / sec",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 55 },
      "datasource": { "type": "prometheus", "uid": "$datasource" },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": { "drawStyle": "stacked_line", "fillOpacity": 30, "spanNulls": true }
        },
        "overrides": []
      },
      "targets": [
        { "expr": "rate(netkeep_dns_snoop_parse_success_total[1m])", "legendFormat": "success", "refId": "A" },
        { "expr": "rate(netkeep_dns_snoop_parse_failed_total[1m])", "legendFormat": "failed", "refId": "B" },
        { "expr": "rate(netkeep_dns_snoop_parse_empty_total[1m])", "legendFormat": "empty", "refId": "C" }
      ]
    },
    {
      "title": "DNS Parse Success Rate",
      "type": "gauge",
      "gridPos": { "h": 8, "w": 4, "x": 16, "y": 55 },
      "datasource": { "type": "prometheus", "uid": "$datasource" },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 0.3 },
              { "color": "green", "value": 0.6 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum(rate(netkeep_dns_snoop_parse_success_total[5m])) / sum(rate(netkeep_dns_snoop_packets_total[5m]))",
          "legendFormat": "success rate",
          "refId": "A"
        }
      ]
    },
    {
      "title": "DNS Parse Latency",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 4, "x": 20, "y": 55 },
      "datasource": { "type": "prometheus", "uid": "$datasource" },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": { "drawStyle": "line", "fillOpacity": 10, "spanNulls": true }
        },
        "overrides": []
      },
      "targets": [
        { "expr": "netkeep_dns_snoop_parse_duration{quantile=\"0.5\"}", "legendFormat": "p50", "refId": "A" },
        { "expr": "netkeep_dns_snoop_parse_duration{quantile=\"0.95\"}", "legendFormat": "p95", "refId": "B" },
        { "expr": "netkeep_dns_snoop_parse_duration{quantile=\"0.99\"}", "legendFormat": "p99", "refId": "C" }
      ]
    },
    {
      "title": "Domain Inference",
      "type": "row",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 63 },
      "collapsed": false
    },
    {
      "title": "SNI / Host Extraction",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 64 },
      "datasource": { "type": "prometheus", "uid": "$datasource" },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": { "drawStyle": "line", "fillOpacity": 10, "spanNulls": true }
        },
        "overrides": []
      },
      "targets": [
        { "expr": "rate(netkeep_sni_extraction_attempts_total[1m])", "legendFormat": "attempts ({{kind}})", "refId": "A" },
        { "expr": "rate(netkeep_sni_extraction_success_total[1m])", "legendFormat": "success ({{source}})", "refId": "B" },
        { "expr": "rate(netkeep_sni_extraction_missed_total[1m])", "legendFormat": "missed ({{kind}})", "refId": "C" },
        { "expr": "rate(netkeep_sni_extraction_skipped_total[1m])", "legendFormat": "skipped (not eligible)", "refId": "D" }
      ]
    },
    {
      "title": "Domain Resolution Source",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 64 },
      "datasource": { "type": "prometheus", "uid": "$datasource" },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": { "drawStyle": "stacked_line", "fillOpacity": 30, "spanNulls": true }
        },
        "overrides": []
      },
      "targets": [
        { "expr": "rate(netkeep_domain_resolved_total[1m])", "legendFormat": "{{source}}", "refId": "A" }
      ]
    },
    {
      "title": "SNI Extraction Success Rate (eligible only)",
      "type": "gauge",
      "gridPos": { "h": 8, "w": 4, "x": 16, "y": 64 },
      "datasource": { "type": "prometheus", "uid": "$datasource" },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 0.2 },
              { "color": "green", "value": 0.5 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum(rate(netkeep_sni_extraction_success_total[5m])) / sum(rate(netkeep_sni_extraction_attempts_total[5m]))",
          "legendFormat": "success rate",
          "refId": "A"
        }
      ]
    },
    {
      "title": "SNI Extraction Latency",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 4, "x": 20, "y": 64 },
      "datasource": { "type": "prometheus", "uid": "$datasource" },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": { "drawStyle": "line", "fillOpacity": 10, "spanNulls": true }
        },
        "overrides": []
      },
      "targets": [
        { "expr": "netkeep_sni_extraction_duration{quantile=\"0.5\"}", "legendFormat": "p50", "refId": "A" },
        { "expr": "netkeep_sni_extraction_duration{quantile=\"0.95\"}", "legendFormat": "p95", "refId": "B" },
        { "expr": "netkeep_sni_extraction_duration{quantile=\"0.99\"}", "legendFormat": "p99", "refId": "C" }
      ]
    },
    {
      "title": "SNI Extraction Rate vs DNS Parse",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 72 },
      "datasource": { "type": "prometheus", "uid": "$datasource" },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": { "drawStyle": "line", "fillOpacity": 10, "spanNulls": true }
        },
        "overrides": [
          {
            "matcher": { "id": "byRegexp", "options": "/success rate/" },
            "properties": [
              { "id": "unit", "value": "percentunit" },
              { "id": "min", "value": 0 },
              { "id": "max", "value": 1 },
              { "id": "custom.axisPlacement", "value": "right" },
              { "id": "custom.drawStyle", "value": "line" },
              { "id": "custom.lineStyle", "value": { "fill": "dash", "dash": [10, 10] } }
            ]
          }
        ]
      },
      "targets": [
        { "expr": "sum(rate(netkeep_sni_extraction_success_total[1m]))", "legendFormat": "SNI success/sec", "refId": "A" },
        { "expr": "sum(rate(netkeep_dns_snoop_parse_success_total[1m]))", "legendFormat": "DNS parse success/sec", "refId": "B" },
        { "expr": "sum(rate(netkeep_dns_snoop_entries_learned_total[1m]))", "legendFormat": "DNS entries learned/sec", "refId": "C" },
        { "expr": "sum(rate(netkeep_sni_extraction_success_total[5m])) / sum(rate(netkeep_sni_extraction_attempts_total[5m]))", "legendFormat": "SNI success rate", "refId": "D" },
        { "expr": "sum(rate(netkeep_dns_snoop_parse_success_total[5m])) / sum(rate(netkeep_dns_snoop_packets_total[5m]))", "legendFormat": "DNS parse success rate", "refId": "E" }
      ]
    },
    {
